{
  "rewrites": [
    { "source": "/mobile", "destination": "/index.html" },
    { "source": "/mobile/", "destination": "/index.html" },
    { "source": "/mobile/concepts/", "destination": "/concepts/index.html" },
    { "source": "/mobile/concepts/:name(mine|liftoff|duel)", "destination": "/concepts/:name.html" },
    { "source": "/mobile/concepts/:name(mine|liftoff|duel)/", "destination": "/concepts/:name.html" },
    { "source": "/mobile/:path*", "destination": "/:path*" }
  ]
}
